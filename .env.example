# MySQL local development
DB_URL=jdbc:mysql://localhost:3306/techsupport360?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=change-me
DDL_AUTO=update
SHOW_SQL=false

# JWT secret: use a unique random value of at least 32 characters
JWT_SECRET=replace-with-a-long-random-secret-of-at-least-32-characters
JWT_EXPIRATION=86400000
PORT=8080
FRONTEND_ORIGIN=http://localhost:5173

# Optional first administrator (all three values required)
ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password-12-chars-minimum
